*.log
watch-log.txt
bring-log.txt
cover-log.txt
launch-log.txt
watcher.lock
edge-closed.flag
cover-*.flag
agent-*.flag
return-request.flag

# Node
node_modules/

# Windows
~$*.pptx
*.pptx:WPSSyncID

# Native build output
native/build/

# Local worktrees and agent workspace
.worktrees/
.superpowers/

# Test fixture deck is intentionally tracked
!native/tests/fixtures/deck.pptx
