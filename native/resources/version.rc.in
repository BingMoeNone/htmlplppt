// Generated from version.rc.in by CMake: version info + the PerMonitorV2
// manifest. Kept free of C headers so windres works without an include path.
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "htmlppt"
      VALUE "FileDescription", "htmlppt watchdog"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "htmlppt-watchdog"
      VALUE "OriginalFilename", "htmlppt-watchdog.exe"
      VALUE "ProductName", "htmlppt watchdog"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 24 "@HTMLPPT_APP_MANIFEST@"
